COMPOSE_PROJECT_NAME=thniya

# Versions figées (voir specs/02-infra-docker.md)
OTP_VERSION=2.10.0
NGINX_VERSION=1.30.5-alpine
PYTHON_VERSION=3.13.16-slim-trixie
GTFS_VALIDATOR_VERSION=8.0.1
PMTILES_VERSION=v1.31.2
POSTGIS_VERSION=18-3.6
DIRECTUS_VERSION=12.4.1
# Recherche d'adresses (https://github.com/komoot/photon/releases) et export GraphHopper de l'Afrique du Nord
PHOTON_VERSION=1.3.0
PHOTON_DUMP_URL=https://download1.graphhopper.com/public/africa/northern-africa/photon-dump-northern-africa-1.0-latest.jsonl.zst
PHOTON_XMX=1g
# Fond de carte : build Protomaps (https://maps.protomaps.com/builds/)
PROTOMAPS_BUILD=20261012

# Mémoire Java d'OTP
OTP_BUILD_XMX=4g
OTP_SERVE_XMX=3g

# Gateway
PUBLIC_HOST=thniya.localhost
HTTP_PORT=80
HTTPS_PORT=443

# Spring
SPRING_PROFILES_ACTIVE=docker

# Carte OSM
OSM_SOURCE_URL=https://download.geofabrik.de/africa/tunisia-latest.osm.pbf
# Grand Tunis : ouest,sud,est,nord (lon/lat) — extrait réduit (outils osm-clip, osm-find)
OSM_CLIP_BBOX=9.95,36.60,10.45,37.00
# Extrait OSM du graphe OTP : tunisie (toute la Tunisie) ou grand-tunis
OTP_REGION=tunisie

# Version des données publiées
DATA_VERSION=dev

# Base de saisie et back-office (specs/04d). Générer des valeurs aléatoires, par ex. : openssl rand -hex 32
POSTGRES_PASSWORD=change-me
DIRECTUS_KEY=change-me
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
DIRECTUS_PUBLIC_URL=http://127.0.0.1:8055
