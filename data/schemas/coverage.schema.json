{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zones de couverture (coverage.yaml)",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "name": { "$ref": "common.schema.json#/$defs/i18n" },
      "level": { "enum": ["complete", "partial"] },
      "modes": { "type": "array", "items": { "type": "string" } },
      "polygon": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/lonLat" }, "minItems": 4 },
      "status": { "$ref": "common.schema.json#/$defs/status" }
    },
    "required": ["id", "name", "level", "modes", "polygon", "status"],
    "additionalProperties": false
  }
}
