{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tarif (networks/<reseau>/fares/*.yaml)",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "model": { "enum": ["flat", "zones", "od_matrix", "od_pairs", "sections"] },
    "currency": { "const": "TND" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "valid_from": { "$ref": "common.schema.json#/$defs/date" },
          "price_millimes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
          "matrix_file": { "type": "string" },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": { "$ref": "common.schema.json#/$defs/id" },
                "to": { "$ref": "common.schema.json#/$defs/id" },
                "price_millimes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
              },
              "required": ["from", "to", "price_millimes"],
              "additionalProperties": false
            }
          }
        },
        "required": ["valid_from"],
        "additionalProperties": false
      }
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "required": ["id", "model", "currency", "versions", "provenance"],
  "additionalProperties": false
}
